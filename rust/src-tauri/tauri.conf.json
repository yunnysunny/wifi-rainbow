{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WiFi Rainbow",
  "version": "0.1.0",
  "identifier": "io.github.yunnysunny.wifi-rainbow",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WiFi 彩虹",
        "width": 1240,
        "height": 760,
        "minWidth": 480,
        "minHeight": 380,
        "maximized": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "WiFi Rainbow",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "homepage": "https://github.com/yunnysunny/wifi-rainbow"
  }
}
